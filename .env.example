# Copy this file to .env and adjust if needed.
# Matches the credentials in docker-compose.yml — works out of the box with `docker compose up -d`.

DATABASE_URL="postgresql://taskforge:taskforge@localhost:5432/taskforge?schema=public"

# Gere a sua com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-gerado-aleatoriamente"

# Opcional em desenvolvimento: sem essa chave, o link de redefinição de senha
# só aparece no console do servidor em vez de ser enviado por e-mail de verdade.
# Crie uma conta em https://resend.com para gerar a sua.
RESEND_API_KEY=""

# Opcional: URL pública usada para montar o link de redefinição de senha.
# Em produção na Vercel isso é detectado automaticamente; defina manualmente
# se estiver usando um domínio próprio.
# NEXT_PUBLIC_APP_URL="https://seu-dominio.com"
