# Copy this file to .env and adjust if needed.
# Matches the credentials in docker-compose.yml — works out of the box with `docker compose up -d`.

DATABASE_URL="postgresql://taskforge:taskforge@localhost:5432/taskforge?schema=public"

# Gere a sua com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-valor-gerado-aleatoriamente"

# Opcional em desenvolvimento: sem essa chave, o link de redefinição de senha
# só aparece no console do servidor em vez de ser enviado por e-mail de verdade.
# Crie uma conta em https://resend.com para gerar a sua.
RESEND_API_KEY=""

# Opcional: URL pública usada para montar o link de redefinição de senha.
# Em produção na Vercel isso é detectado automaticamente; defina manualmente
# se estiver usando um domínio próprio.
# NEXT_PUBLIC_APP_URL="https://seu-dominio.com"

# Opcionais: login social. Sem essas variáveis, os botões de GitHub/Google
# simplesmente não aparecem nas telas de login/cadastro.
# AUTH_GITHUB_ID=""
# AUTH_GITHUB_SECRET=""
# AUTH_GOOGLE_ID=""
# AUTH_GOOGLE_SECRET=""

# Opcionais: monitoramento de erros com o Sentry (navegador e servidor). Sem
# essas variáveis, o Sentry simplesmente não é inicializado.
# Crie uma conta gratuita em https://sentry.io para gerar as suas.
# NEXT_PUBLIC_SENTRY_DSN=""
# SENTRY_DSN=""
# Opcionais, só usadas no build para enviar source maps ao Sentry:
# SENTRY_ORG=""
# SENTRY_PROJECT=""
# SENTRY_AUTH_TOKEN=""

# Opcionais: rate limiting em /api/register, no login e na solicitação de
# redefinição de senha (via Upstash Redis). Sem essas variáveis, o rate
# limiting simplesmente não é aplicado — o app funciona normalmente.
# Crie um banco gratuito em https://console.upstash.com para gerar as suas.
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
